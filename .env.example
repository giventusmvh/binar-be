# ===========================================
# Binar-BE Environment Configuration
# ===========================================
# Copy this file to .env and update values
# cp .env.example .env

# ===========================================
# Docker Container Names
# ===========================================
APP_CONTAINER_NAME=binar-be-app
DB_CONTAINER_NAME=binar-be-sqlserver
REDIS_CONTAINER_NAME=binar-be-redis

# ===========================================
# Application
# ===========================================
APP_PORT=8080

# ===========================================
# Database (SQL Server)
# ===========================================
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=binar-be;encrypt=true;trustServerCertificate=true
DB_HOST=sqlserver
DB_PORT=1433
DB_EXTERNAL_PORT=1433
DB_NAME=binar-be
DB_USERNAME=sa
DB_PASSWORD=StrongPass123!
MSSQL_PID=Express

# ===========================================
# JPA/Hibernate
# ===========================================
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# ===========================================
# Redis
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_EXTERNAL_PORT=6380
REDIS_PASSWORD=

# ===========================================
# JWT
# ===========================================
JWT_SECRET=YmluYXItYmUtbG9hbi1hcHBsaWNhdGlvbi1zZWNyZXQta2V5LTIwMjQtdGhpcy1pcy1hLXZlcnktc2VjdXJlLWtleS1mb3Itand0LXNpZ25pbmctbWluaW11bS0yNTYtYml0cw==
JWT_EXPIRATION=86400000

# ===========================================
# Email (Mailtrap for development)
# ===========================================
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=73b26d3ab7aa6e
MAIL_PASSWORD=bcc8252b75c872

# ===========================================
# Password Reset
# ===========================================
PASSWORD_RESET_EXPIRY=30
PASSWORD_RESET_BASE_URL=http://localhost:4200/reset-password

# ===========================================
# Logging
# ===========================================
LOG_LEVEL_SECURITY=DEBUG
LOG_LEVEL_APP=DEBUG

# ===========================================
# GCP Production Example Values
# ===========================================
# DB_URL=jdbc:sqlserver://your-cloud-sql-ip:1433;databaseName=binar-be;encrypt=true;trustServerCertificate=true
# DB_HOST=your-cloud-sql-ip
# DB_PASSWORD=your-secure-production-password
# REDIS_HOST=your-memorystore-ip
# REDIS_PASSWORD=your-redis-password
# JWT_SECRET=your-production-jwt-secret
# MAIL_HOST=smtp.sendgrid.net
# PASSWORD_RESET_BASE_URL=https://your-domain.com/reset-password
# LOG_LEVEL_SECURITY=WARN
# LOG_LEVEL_APP=INFO
