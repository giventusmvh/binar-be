# ===========================================
# Binar-BE Docker Environment Configuration
# ===========================================
# Copy this file to .env and update values
# cp .env.example .env

# Application
APP_CONTAINER_NAME=binar-be-app
APP_PORT=8080

# Database (SQL Server)
DB_CONTAINER_NAME=binar-be-sqlserver
DB_HOST=sqlserver
DB_PORT=1433
DB_EXTERNAL_PORT=1433
DB_NAME=binar-be
DB_USERNAME=sa
DB_PASSWORD=StrongPass123!
MSSQL_PID=Express

# Redis
REDIS_CONTAINER_NAME=binar-be-redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6380
REDIS_PASSWORD=

# JWT
JWT_SECRET=YmluYXItYmUtbG9hbi1hcHBsaWNhdGlvbi1zZWNyZXQta2V5LTIwMjQtdGhpcy1pcy1hLXZlcnktc2VjdXJlLWtleS1mb3Itand0LXNpZ25pbmctbWluaW11bS0yNTYtYml0cw==
JWT_EXPIRATION=86400000

# Email (Mailtrap for development)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password

# Password Reset
PASSWORD_RESET_BASE_URL=http://localhost:4200/reset-password

